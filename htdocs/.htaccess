<FilesMatch "^\.env|\.sql$">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    Options +FollowSymlinks
    RewriteEngine On

    # Forcer HTTPS uniquement si la requête est en HTTP
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Envoyer les requêtes vers CodeIgniter public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>