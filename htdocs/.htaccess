<FilesMatch "^\.env|\.sql$">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    Options +FollowSymlinks
    RewriteEngine On

    # Redirection HTTPS propre (si inactif)
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Redirection invisible vers le dossier public de CodeIgniter
    RewriteRule ^(.*)$ public/$1 [L,NC]
</IfModule>