<FilesMatch "^\.env|\.sql$">
    Require all denied
</FilesMatch>


<IfModule mod_rewrite.c>

    Options +FollowSymlinks
    RewriteEngine On


    # ==========================================================
    # HTTPS (Forcé partout SAUF en local)
    # ==========================================================
    
    # RewriteCond %{HTTP_HOST} !^perso\.local$ [NC]
    # RewriteCond %{HTTP_HOST} !^localhost$ [NC]
    # RewriteCond %{HTTPS} off
    # RewriteCond %{HTTP:X-Forwarded-Proto} !https
    # RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]


    # ==========================================================
    # NE PAS REECRIRE PUBLIC SUR LUI-MÊME
    # ==========================================================

    # Redirect explicit /public URLs to their short form.
    # THE_REQUEST distinguishes browser requests from internal rewrites,
    # which prevents a redirect loop.
    RewriteCond %{THE_REQUEST} \s/+public(?:/|[?\s]) [NC]
    RewriteRule ^public(?:/(.*))?$ /$1 [R=301,L,NE]

    # Allow the internal rewrite to the public directory.
    RewriteRule ^public(?:/|$) - [L]


    # ==========================================================
    # ENVOYER LE SITE VERS PUBLIC
    # ==========================================================

    RewriteRule ^(.*)$ public/$1 [L]

</IfModule>
