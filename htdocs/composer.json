{
    "name": "titiss/space",
    "description": "Application web CodeIgniter 4",
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.5",
        "ext-intl": "*",
        "ext-mbstring": "*",
        "codeigniter4/shield": "^1.4",
        "laminas/laminas-escaper": "^2.14",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "codeigniter/coding-standard": "^1.7",
        "fakerphp/faker": "^1.24",
        "friendsofphp/php-cs-fixer": "^3.95",
        "kint-php/kint": "^6.0",
        "nexusphp/cs-config": "^3.6",
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^10.5.16 || ^11.2"
    },
    "autoload": {
        "psr-4": {
            "CodeIgniter\\": "system/"
        },
        "exclude-from-classmap": [
            "**/Database/Migrations/**"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    }
}