{
    "name": "codeigniter4/appstarter",
    "type": "project",
    "description": "CodeIgniter 4 Starter Application",
    "license": "MIT",
    "require": {
        "php": "*",
        "codeigniter4/framework": "*",
        "codeigniter4/shield": "*"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Config\\": "app/Config/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    }
}