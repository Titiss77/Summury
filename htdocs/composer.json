{
    "name": "codeigniter4/appstarter",
    "type": "project",
    "description": "CodeIgniter 4 Starter Application",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "codeigniter4/framework": "^4.5",
        "codeigniter4/shield": "^1.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Config\\": "app/Config/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    }
}