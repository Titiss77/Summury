#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------

# Configuration pour le mode DEVELOPMENT
CI_ENVIRONMENT = development

# Configuration pour le mode PRODUCTION
#CI_ENVIRONMENT = production

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------

# Configuration pour le mode DEVELOPMENT
app.baseURL = ''

# Configuration pour le mode PRODUCTION
#app.baseURL = ''

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------

# Configuration pour le mode DEVELOPMENT
database.development.hostname = localhost
database.development.database = 
database.development.username = 
database.development.password = 
database.development.DBDriver = MySQLi

# Configuration pour le mode PRODUCTION
database.production.hostname = 
database.production.database = 
database.production.username = 
database.production.password = 
database.production.DBDriver = MySQLi

SITENAME=
EMAILPRO=
PSEUDO=

#--------------------------------------------------------------------
# API
#--------------------------------------------------------------------
TMDB_API_KEY=
YOUTUBE_API_KEY=

#--------------------------------------------------------------------
# SESSION & SECURITE
#--------------------------------------------------------------------

PHP_CS_FIXER_IGNORE_ENV=1

#--------------------------------------------------------------------
# EMAIL SMTP CONFIGURATION
#--------------------------------------------------------------------
Email.protocol   = 'smtp'
Email.SMTPHost   = 'smtp.votre-serveur-email.com'
Email.SMTPUser   = 'votre-email@domaine.com'
Email.SMTPPass   = 'votre-mot-de-passe'
Email.SMTPPort   = 465
Email.SMTPCrypto = 'ssl'
Email.mailType = html

# Optionnel : Forcer l'expéditeur global
Email.fromEmail  = 'contact@titiss.space'
Email.fromName   = 'CARDEX'